GPUSTACK_API_KEY=your_key_here
GPUSTACK_BASE_URL=https://gpustack.data.lmru.tech/v1
GPUSTACK_MODEL=deepseek-v4.1-flash
# Models available in the "Модель" selector; the first ones below use the main key.
GPUSTACK_MODELS=deepseek-v4.1-flash,qwen3.8-27b,gpt-4o
# Optional per-model overrides (format: model=value,...) for models on other providers:
GPUSTACK_KEYS=
GPUSTACK_BASE_URLS=
# Prices per 1M tokens (in;out) for local cost estimate, RUB:
GPUSTACK_PRICES=deepseek-v4.1-flash=10;30,qwen3.8-27b=30;90
GPUSTACK_PRICE_DEFAULT=10;30
