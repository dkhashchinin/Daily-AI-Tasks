GPUSTACK_API_KEY=your_key_here
GPUSTACK_BASE_URL=https://gpustack.data.lmru.tech/v1
GPUSTACK_MODEL=deepseek-v4.1-flash
GPUSTACK_MODELS=deepseek-v4.1-flash,qwen3.8-27b
# Токен T-Invest API: Приложение Т-Банк/Тинькофф Инвестиции -> Настройки -> Токен для T-Invest API.
# Для песочницы нужен отдельный токен, выпущенный в режиме песочницы.
INVEST_TOKEN=your_invest_token_here
# Контур API: sandbox (по умолчанию) или prod
INVEST_TARGET=sandbox
# Опционально: свой CA-bundle в PEM. По умолчанию используется бандл
# mcp_tbank_invest/certs/russian_trusted_root_ca.pem (сертификаты Минцифры).
# INVEST_CA_CERT=C:\path\to\ca.pem

# Планировщик
# Период сбора данных, секунд
SCHED_INTERVAL_SEC=30
# Период агрегированного отчёта, секунд
SCHED_REPORT_INTERVAL_SEC=120
# Глубина отчёта: сколько часов накопленных данных агрегировать (0 = вся история)
SCHED_REPORT_HOURS=24
# Какие валюты ЦБ собирать: коды через запятую, до 8 (USD, EUR, CNY, GBP, JPY, KZT, TRY, CHF...)
SCHED_CURRENCIES=USD, EUR, CNY, GBP
