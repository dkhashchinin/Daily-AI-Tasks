GPUSTACK_API_KEY=your_key_here
GPUSTACK_BASE_URL=https://gpustack.data.lmru.tech/v1
GPUSTACK_MODEL=deepseek-v4.1-flash
GPUSTACK_MODELS=deepseek-v4.1-flash,qwen3.8-27b
# Optional per-model keys if models need different credentials:
# GPUSTACK_KEYS=qwen3.8-27b=your_qwen_key_here
# Optional per-model base URLs if some models live on another OpenAI-compatible API:
# GPUSTACK_BASE_URLS=cohere/north-mini-code:free=https://api.zveno.ai/v1

# Optional per-model token prices, rubles per 1M tokens (prompt;completion) for the comparison cost column:
# GPUSTACK_PRICES=deepseek-v4.1-flash=10;30,qwen3.8-27b=30;90
# Default token price (rubles per 1M tokens) for models without a specific price:
# GPUSTACK_PRICE_DEFAULT=10;30

